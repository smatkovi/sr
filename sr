    @Slot(int)
    def playChannel(self, channelId):
        """Play live channel using HTTP stream"""
        print u"Playing channel: %d" % channelId
        
        # Find channel info
        for c in CHANNELS:
            if c['id'] == channelId:
                self._playName = c['name']
                self._playImage = c.get('image', '')
                break
        
        # Use HTTP stream URL from map, fallback to generic
        if channelId in STREAM_MAP:
            self._playUrl = STREAM_MAP[channelId]
        else:
            # Fallback: versuche generisches Format (HTTP)
            self._playUrl = "http://http-live.sr.se/p%d-mp3-192" % channelId
        
        print u"Stream URL: %s" % self._playUrl
        self.playUrlChanged.emit()
    
    @Slot(str, str, str)
    def playEpisode(self, url, name, imageUrl):
        """Play episode - convert HTTPS to HTTP"""
        print u"Playing episode: %s" % name
        # Convert HTTPS to HTTP for SSL-less playback
        if url.startswith('https://'):
            url = url.replace('https://', 'http://')
        self._playUrl = url
        self._playName = name
        self._playImage = imageUrl
        print u"Episode URL: %s" % self._playUrl
        self.playUrlChanged.emit()
    
    @Slot(str, result=str)
    def getChannelStreamUrl(self, channelId):
        """Get HTTP stream URL for channel"""
        cid = int(channelId) if channelId.isdigit() else 0
        if cid in STREAM_MAP:
            return STREAM_MAP[cid]
        return "http://http-live.sr.se/p%s-mp3-192" % channelId
    
    # ==================== DOWNLOAD ====================
    
    def _sanitizeFilename(self, name):
        """Create safe filename"""
        if isinstance(name, str):
            name = name.decode('utf-8', 'ignore')
        safe = name.replace(u'/', u'-').replace(u':', u'-').replace(u'?', u'')
        safe = safe.replace(u'"', u'').replace(u'*', u'').replace(u'<', u'').replace(u'>', u'')
        safe = safe.replace(u'|', u'-').replace(u'\\', u'-')
        # Kürzen wenn zu lang
        if len(safe) > 100:
            safe = safe[:100]
        return safe
    
    @Slot(str, str)
    def downloadEpisode(self, url, title):
        """Download episode to MyDocs"""
        import os
        import re
        
        print u"Downloading: %s" % title
        
        # Download-Verzeichnis
        download_dir = u"/home/user/MyDocs/sr"
        if not os.path.exists(download_dir):
            try:
                os.makedirs(download_dir)
            except:
                download_dir = u"/home/user/MyDocs"
        
        # Extrahiere Episode-ID aus URL (z.B. 10022861 aus .../10022861.mp3)
        episode_id = ""
        match = re.search(r'/(\d+)\.mp3', url)
        if match:
            episode_id = match.group(1)
        
        # Sichere Dateiname mit ID
        safe_name = self._sanitizeFilename(title)
        if episode_id:
            self._downloadFile = os.path.join(download_dir, u"%s_%s.mp3" % (safe_name, episode_id))
        else:
            self._downloadFile = os.path.join(download_dir, safe_name + u".mp3")
        
        print u"Saving to: %s" % self._downloadFile
        
        # URL anpassen
        if url.startswith('https://'):
            url = url.replace('https://', 'http://')
        
        # Hole Dateigröße
        self._downloadSize = 0
        try:
            proc = subprocess.Popen(
                ['/opt/wunderw/bin/wget', '--spider', '-S', '--timeout=10', url],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE
            )
            _, stderr = proc.communicate()
            for line in stderr.split('\n'):
                if 'Content-Length:' in line:
                    parts = line.split('Content-Length:')
                    if len(parts) > 1:
                        self._downloadSize = int(parts[1].strip().split()[0])
                        break
        except:
            pass
        
        # Starte Download
        self._downloadActive = True
        self._downloadProgress = 0
        self.downloadProgressChanged.emit()
        
        self._downloadProc = subprocess.Popen(
            ['/opt/wunderw/bin/wget', '-q', '-O', self._downloadFile, url],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE
        )
        
        self.downloadTimer.start(500)
    
    def _checkDownloadProgress(self):
        """Check download progress"""
        import os
        
        if self._downloadProc and self._downloadProc.poll() is not None:
            # Download fertig
            self._downloadActive = False
            self.downloadTimer.stop()
            
            if os.path.exists(self._downloadFile):
                size = os.path.getsize(self._downloadFile)
                if size > 0:
                    self._downloadProgress = 100
                    print u"Download complete: %s (%d bytes)" % (self._downloadFile, size)
                    self.downloadFinished.emit()
                else:
                    print u"Download failed: empty file"
            
            self._downloadProc = None
            self.downloadProgressChanged.emit()
            return
        
        # Progress berechnen
        import os
        if self._downloadSize > 0 and os.path.exists(self._downloadFile):
            current = os.path.getsize(self._downloadFile)
            self._downloadProgress = int(100 * current / self._downloadSize)
            self.downloadProgressChanged.emit()
    
    @Slot()
    def cancelDownload(self):
        """Cancel current download"""
        if self._downloadProc:
            try:
                self._downloadProc.terminate()
            except:
                pass
            self._downloadProc = None
        self._downloadActive = False
        self.downloadTimer.stop()
        self.downloadProgressChanged.emit()
    
    @Slot(str, str, str)
    def playEpisodeOrLocal(self, url, name, imageUrl):
        """Play local file if exists, otherwise stream"""
        import os
        import re
        
        download_dir = u"/home/user/MyDocs/sr"
        safe_name = self._sanitizeFilename(name)
        
        # Extrahiere Episode-ID aus URL
        episode_id = ""
        match = re.search(r'/(\d+)\.mp3', url)
        if match:
            episode_id = match.group(1)
        
        # Suche lokale Datei (mit ID wenn vorhanden)
        if episode_id:
            local_file = os.path.join(download_dir, u"%s_%s.mp3" % (safe_name, episode_id))
        else:
            local_file = os.path.join(download_dir, safe_name + u".mp3")
        
        if os.path.exists(local_file):
            print u"Playing local file: %s" % local_file
            self._playUrl = "file://" + local_file
            self._playName = name
            self._playImage = imageUrl
            self.playUrlChanged.emit()
            return
        
        # Fallback: Alte Datei ohne ID
        old_file = os.path.join(download_dir, safe_name + u".mp3")
        if os.path.exists(old_file):
            print u"Playing local file (old format): %s" % old_file
            self._playUrl = "file://" + old_file
            self._playName = name
            self._playImage = imageUrl
            self.playUrlChanged.emit()
            return
        
        # Keine lokale Datei, stream
        self.playEpisode(url, name, imageUrl)
    
    @Slot(str, str, result=bool)
    def isDownloaded(self, url, title):
        """Check if episode is downloaded locally"""
        import os
        import re
        
        # Frühe Rückgabe bei leeren Werten
        if not url or not title:
            return False
        
        download_dir = u"/home/user/MyDocs/sr"
        if not os.path.exists(download_dir):
            return False
        
        safe_name = self._sanitizeFilename(title)
        
        # Extrahiere Episode-ID aus URL
        episode_id = ""
        match = re.search(r'/(\d+)\.mp3', url)
        if match:
            episode_id = match.group(1)
        
        # Prüfe Datei mit ID
        if episode_id:
            local_file = os.path.join(download_dir, u"%s_%s.mp3" % (safe_name, episode_id))
            if os.path.exists(local_file):
                print u"Found downloaded: %s" % local_file
                return True
        
        # Prüfe alte Datei ohne ID
        old_file = os.path.join(download_dir, safe_name + u".mp3")
        if os.path.exists(old_file):
            print u"Found downloaded (old): %s" % old_file
            return True
        
        return False


