    @Slot(int)
    def loadCurrentShow(self, channelId):
        """Load current show for channel"""
        print u"Loading current show for channel: %d" % channelId
        
        def worker():
            try:
                url = "%s/scheduledepisodes/rightnow?channelid=%d&format=json" % (API_BASE, channelId)
                data = self._fetchUrl(url)
                if data:
                    self._pending['currentShow_%d' % channelId] = data
            except Exception as e:
                print u"Current show error: %s" % e
        
        t = threading.Thread(target=worker)
        t.daemon = True
        t.start()
        
        key = 'currentShow_%d' % channelId
        def check():
            if key in self._pending:
                data = self._pending.pop(key)
                self._handleCurrentShow(data, channelId)
            elif t.is_alive():
                QTimer.singleShot(200, check)
        
        QTimer.singleShot(200, check)
    
    def _handleCurrentShow(self, data, channelId):
        """Parse current show"""
        try:
            response = json.loads(data)
            channel = response.get('channel', {})
            current = channel.get('currentscheduledepisode', {})
            next_ep = channel.get('nextscheduledepisode', {})
            
            show = {
                'channelId': channelId,
                'channelName': channel.get('name', ''),
                'title': current.get('title', channel.get('name', '')),
                'description': current.get('description', ''),
                'nextTitle': next_ep.get('title', ''),
                'nextStart': next_ep.get('starttimeutc', '')
            }
            
            self._currentShowJson = json.dumps(show)
            self.currentShowChanged.emit()
            
        except Exception as e:
            print u"Parse current show error: %s" % e
    
