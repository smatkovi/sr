    def _handleLatest(self, data):
        """Parse latest episodes"""
        try:
            response = json.loads(data)
            shows = response.get('shows', [])
            
            items = []
            for s in shows[:20]:
                # Get playback URL
                url = ''
                if s.get('listenpodfile'):
                    url = s['listenpodfile'].get('url', '')
                elif s.get('broadcast') and s['broadcast'].get('broadcastfiles'):
                    files = s['broadcast']['broadcastfiles']
                    if files:
                        url = files[0].get('url', '')
                
                if url:
                    item = {
                        'id': s.get('id', 0),
                        'title': s.get('title', ''),
                        'programName': s.get('program', {}).get('name', ''),
                        'programId': s.get('program', {}).get('id', 0),
                        'imageUrl': s.get('imageurl', ''),
                        'url': url,
                        'description': s.get('description', '')
                    }
                    items.append(item)
            
            print u"Found %d latest episodes" % len(items)
