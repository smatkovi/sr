    @Slot()
    def loadAllChannels(self):
        """Load all channels from API"""
        print u"Loading all channels..."
        
        def worker():
            try:
                url = "%s/channels?format=json&pagination=false" % API_BASE
                data = self._fetchUrl(url)
                if data:
                    self._pending['allChannels'] = data
            except Exception as e:
                print u"Channels error: %s" % e
        
        t = threading.Thread(target=worker)
        t.daemon = True
        t.start()
        
        def check():
            if 'allChannels' in self._pending:
                data = self._pending.pop('allChannels')
                self._handleAllChannels(data)
            elif t.is_alive():
                QTimer.singleShot(200, check)
        
        QTimer.singleShot(200, check)
    
    def _handleAllChannels(self, data):
        """Parse all channels"""
        try:
            response = json.loads(data)
            channels = response.get('channels', [])
            
            items = []
            for c in channels:
                item = {
                    'id': c.get('id', 0),
                    'name': c.get('name', ''),
                    'image': c.get('image', '')
                }
                items.append(item)
            
            print u"Found %d channels" % len(items)
            self._channelsJson = json.dumps(items)
            self.channelsChanged.emit()
            
        except Exception as e:
            print u"Parse channels error: %s" % e
    
